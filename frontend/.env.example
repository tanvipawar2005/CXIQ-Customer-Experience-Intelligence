# Copy this file to .env and fill in values as needed.
# CXIQ works fully in guest mode without this file at all.

# Optional: enables "Sign In" / user accounts via Clerk. Get a free
# publishable key at https://dashboard.clerk.com after creating an
# application. Leave unset to run CXIQ without login — every feature
# still works.
VITE_CLERK_PUBLISHABLE_KEY=
