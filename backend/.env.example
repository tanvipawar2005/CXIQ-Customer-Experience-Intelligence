# Copy this file to .env and fill in values as needed.
# CXIQ works without these optional integrations.

# ======================================
# GEMINI AI (Optional)
# ======================================
# Enables the AI Business Assistant.
# If blank, CXIQ uses its built-in
# rule-based recommendation engine.
# Get a key from https://aistudio.google.com/apikey

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ======================================
# CORS CONFIGURATION
# ======================================
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ======================================
# POSTGRESQL DATABASE (Optional)
# ======================================
# Set your database URL in .env.
# If blank, CXIQ uses in-memory storage.

DATABASE_URL=

# Example format:
# DATABASE_URL=postgresql://USERNAME:PASSWORD@localhost:5432/cxiq

# ======================================
# CLERK AUTHENTICATION (Optional)
# ======================================
# Leave blank to run in guest mode.
# Get values from your Clerk dashboard.

CLERK_ISSUER=
CLERK_JWKS_URL=

# Example:
# CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json